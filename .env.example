# GAME HUB PROJECT AUDITOR — сервер параметрлерінің үлгісі
# НАҚТЫ МӘНДЕРДІ ЕШҚАШАН GIT-КЕ КОСПАҢЫЗ. Бұл файлда тек толтырғыштар берілген.

# Сервер порты
PORT=8787

# Әкімші кілті (жүйеге кіру үшін). Күшті кездейсоқ жол таңдаңыз:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=ADMIN_TOKEN_OSINDY_KUCHTI_KEZDEYSOK_ZHOL_ZHAZYNYS

# Деректер мен дәлелдер каталогы
DATA_DIR=./data
EVIDENCE_DIR=./data/evidence

# Жұмыс шектеулері
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_MS=600000
NAV_TIMEOUT_MS=30000
PAGE_ACTION_TIMEOUT_MS=8000
MAX_NETWORK_REQUESTS=400
DUPLICATE_WINDOW_MINUTES=5

# ТЕК СЫНАҚ ҮШІН: localhost-тағы fixture сайтына рұқсат.
# ӨНДІРІСТЕ ЕШҚАШАН "1" ҚОЙМАҢЫЗ — бұл SSRF қорғанысын әлсіретеді!
ALLOW_LOCALHOST_FOR_TESTS=0

# Firebase Firestore (қосымша). Бапталмаса — JSON файл сақтауышы қолданылады.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google OAuth (қосымша — аудитордың өз кіру жүйесі үшін)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
